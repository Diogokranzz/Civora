{
  "name": "civora",
  "version": "1.0.0",
  "private": true,
  "description": "Civora — Enterprise ITSM, Ticket, Incident, SLA, Asset, Automation & Knowledge Operations Platform",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:pages": "node apps/web/scripts/build-pages.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @civora/api test:integration",
    "test:e2e": "pnpm --filter @civora/web test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @civora/api db:generate",
    "db:migrate": "pnpm --filter @civora/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @civora/api db:migrate:deploy",
    "db:seed": "pnpm --filter @civora/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}

