# Runtime Environment
NODE_ENV=development
APP_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://civora:civora_dev_password@localhost:5432/civora?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# API & Web URLs
API_PORT=4000
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"

# Authentication & Security (DO NOT USE THESE SECRETS IN PRODUCTION)
JWT_ACCESS_SECRET="civora-dev-access-secret-change-in-production-32chars-min"
JWT_REFRESH_SECRET="civora-dev-refresh-secret-change-in-production-32chars-min"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional OpenID Connect (Keycloak / Enterprise IdP)
OIDC_ENABLED=false
OIDC_ISSUER_URL=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_REDIRECT_URI="http://localhost:4000/api/v1/auth/oidc/callback"

# Object Storage (MinIO locally / Amazon S3 in production)
STORAGE_PROVIDER=s3
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="civora-attachments"
S3_ACCESS_KEY="civora_minio"
S3_SECRET_KEY="civora_minio_secret"
S3_FORCE_PATH_STYLE=true

# Email (Mailpit locally / SMTP or Microsoft Graph in production)
EMAIL_PROVIDER=smtp
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Civora Platform <noreply@civora.local>"

# Optional AI Layer (Civora runs 100% natively if AI_PROVIDER=disabled)
AI_PROVIDER=disabled
AI_API_BASE_URL=""
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS=8000

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
LOG_LEVEL=info

