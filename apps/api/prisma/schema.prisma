  revokedAt   DateTime? @map("revoked_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("consent_records")
}

model AiSuggestion {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  ticketId          String?    @map("ticket_id") @db.Uuid
  actorId           String     @map("actor_id") @db.Uuid
  featureType       String     @map("feature_type") @db.VarChar(60)
  provider          String     @db.VarChar(60)
  model             String     @db.VarChar(100)
  promptVersion     String     @map("prompt_version") @db.VarChar(32)
  latencyMs         Int        @map("latency_ms")
  tokenUsage        Int        @default(0) @map("token_usage")
  suggestionPayload Json       @map("suggestion_payload")
  decision          AiDecision @default(PENDING)
  decidedAt         DateTime?  @map("decided_at")
  createdAt         DateTime   @default(now()) @map("created_at")

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt(sort: Desc)])
  @@map("ai_suggestions")
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(60)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(80)
  eventVersion  Int          @default(1) @map("event_version")
  payload       Json
  correlationId String       @map("correlation_id") @db.VarChar(64)
  causationId   String?      @map("causation_id") @db.VarChar(64)
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  publishedAt   DateTime?    @map("published_at")
  lastError     String?      @map("last_error") @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([tenantId, aggregateId])
  @@map("outbox_events")
}

model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, actorId, idempotencyKey, method, path])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

