generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TicketStatus {
  NEW
  TRIAGE
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  WAITING_THIRD_PARTY
  WAITING_APPROVAL
  RESOLVED
  CLOSED
  CANCELED
  REOPENED
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  ACCESS_REQUEST
  QUESTION
  CHANGE_REQUEST
}

enum TicketChannel {
  PORTAL
  AGENT_CONSOLE
  EMAIL
  API
  WEBHOOK
  SLACK
  TEAMS
}

enum ImpactUrgency {
  LOW
  MEDIUM
  HIGH
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ParticipantKind {
  WATCHER
  COLLABORATOR
}

enum SlaInstanceState {
  ACTIVE
  PAUSED
  WARNING
  BREACHED
  MET
  CANCELED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

enum AutomationTrigger {
  TICKET_CREATED
  TICKET_STATUS_CHANGED
  TICKET_PRIORITY_CHANGED
  TICKET_ASSIGNEE_CHANGED
  SLA_WARNING_REACHED
  SLA_BREACHED
  COMMENT_ADDED
  APPROVAL_RESPONDED
  TICKET_STALE
  WEBHOOK_RECEIVED
}

enum AutomationExecutionStatus {
  SUCCEEDED
  FAILED
  SKIPPED_LOOP
  DEAD_LETTER
}

enum KnowledgeStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KnowledgeVisibility {
  INTERNAL
  PUBLIC
}

enum AssetStatus {
  ACTIVE
  IN_MAINTENANCE
  RETIRED
  DISPOSED
  LOST
}

enum ProblemStatus {
  LOGGED
  INVESTIGATING
  KNOWN_ERROR
  RESOLVED
  CLOSED
}

enum ChangeStatus {
  DRAFT
  ASSESSMENT
  CAB_APPROVAL
  SCHEDULED
  IMPLEMENTING
  COMPLETED
  ROLLED_BACK
  CANCELED
}

enum ChangeRisk {
  LOW
  MEDIUM
  HIGH
  EMERGENCY
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  DEAD_LETTER
}

enum AiDecision {
  PENDING
  ACCEPTED
  REJECTED
}

// ---------------------------------------------------------------------------
// Multi-tenancy, Organization & RBAC
// ---------------------------------------------------------------------------

model Organization {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(180)
  slug              String   @unique @db.VarChar(80)
  defaultTimezone   String   @default("America/Sao_Paulo") @map("default_timezone") @db.VarChar(64)
  aiEnabled         Boolean  @default(true) @map("ai_enabled")
  dataRetentionDays Int      @default(1825) @map("data_retention_days")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscription     Subscription?
  featureFlags     FeatureFlag[]
  units            Unit[]
  departments      Department[]
  teams            Team[]
  memberships      Membership[]
  categories       Category[]
  services         Service[]
  businessCalendars BusinessCalendar[]
  slaPolicies      SlaPolicy[]
  tickets          Ticket[]
  ticketSequences  TicketSequence[]
  automationRules  AutomationRule[]
  knowledgeArticles KnowledgeArticle[]
  assets           Asset[]
  problems         Problem[]
  changes          Change[]
  webhookEndpoints WebhookEndpoint[]
  auditLogs        AuditLog[]
  lgpdRequests     LgpdRequest[]
  consentRecords   ConsentRecord[]
  savedViews       SavedTicketView[]

  @@map("organizations")
}

model Subscription {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id") @db.Uuid
  plan           String   @default("ENTERPRISE") @db.VarChar(40)
  status         String   @default("ACTIVE") @db.VarChar(30)
  maxAgents      Int      @default(100) @map("max_agents")
  maxUnits       Int      @default(25) @map("max_units")
  renewsAt       DateTime? @map("renews_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model FeatureFlag {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String   @db.VarChar(80)
  enabled        Boolean  @default(false)
  config         Json?
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("feature_flags")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(140)
  code      String   @db.VarChar(32)
  timezone  String   @default("America/Sao_Paulo") @db.VarChar(64)
  address   String?  @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  departments  Department[]
  memberships  Membership[]
  tickets      Ticket[]
  slaPolicies  SlaPolicy[]
  assets       Asset[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("units")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  unitId    String?  @map("unit_id") @db.Uuid
  name      String   @db.VarChar(140)
  code      String   @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  teams        Team[]
  memberships  Membership[]
  tickets      Ticket[]
  services     Service[]
  slaPolicies  SlaPolicy[]
  assets       Asset[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model Team {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  name         String   @db.VarChar(140)
  supervisorId String?  @map("supervisor_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  supervisor   User?        @relation("TeamSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  members      TeamMember[]
  tickets      Ticket[]     @relation("TicketAssignedTeam")
  services     Service[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([tenantId, userId])
  @@map("team_members")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique @db.VarChar(255)
  name               String    @db.VarChar(160)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  oidcSubject        String?   @unique @map("oidc_subject") @db.VarChar(180)
  avatarUrl          String?   @map("avatar_url") @db.VarChar(512)
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaSecretEncrypted String?   @map("mfa_secret_encrypted") @db.VarChar(512)
  isPlatformAdmin    Boolean   @default(false) @map("is_platform_admin")
  anonymizedAt       DateTime? @map("anonymized_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  refreshTokens           RefreshToken[]
  supervisedTeams         Team[]                   @relation("TeamSupervisor")
  teamMemberships         TeamMember[]
  requestedTickets        Ticket[]                 @relation("TicketRequester")
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  ticketParticipations    TicketParticipant[]
  ticketComments          TicketComment[]
  ticketAttachments       TicketAttachment[]
  ticketEvents            TicketEvent[]
  statusChanges           TicketStatusHistory[]
  assignmentsFrom         TicketAssignment[]       @relation("AssignmentPrevious")
  assignmentsTo           TicketAssignment[]       @relation("AssignmentNew")
  assignmentsActor        TicketAssignment[]       @relation("AssignmentActor")
  requestedApprovals      Approval[]               @relation("ApprovalRequester")
  approvalSteps           ApprovalStep[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  authoredArticles        KnowledgeArticle[]       @relation("ArticleAuthor")
  reviewedArticles        KnowledgeArticle[]       @relation("ArticleReviewer")
  articleVersions         KnowledgeArticleVersion[]
  ownedAssets             Asset[]
  auditLogs               AuditLog[]
  lgpdRequests            LgpdRequest[]
  consentRecords          ConsentRecord[]
  savedViews              SavedTicketView[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(60)
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]
  memberships     Membership[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  defaultUnitId  String?  @map("default_unit_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  defaultUnit  Unit?        @relation(fields: [defaultUnitId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  familyId          String    @map("family_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Service Catalog & Dynamic Forms
// ---------------------------------------------------------------------------

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @db.VarChar(120)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]         @relation("CategoryTree")
  services     Service[]
  tickets      Ticket[]
  slaPolicies  SlaPolicy[]
  articles     KnowledgeArticle[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("categories")
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  categoryId      String?   @map("category_id") @db.Uuid
  departmentId    String?   @map("department_id") @db.Uuid
  defaultTeamId   String?   @map("default_team_id") @db.Uuid
  name            String    @db.VarChar(160)
  slug            String    @db.VarChar(120)
  description     String    @db.Text
  defaultType     TicketType @default(SERVICE_REQUEST) @map("default_type")
  defaultImpact   ImpactUrgency @default(MEDIUM) @map("default_impact")
  defaultUrgency  ImpactUrgency @default(MEDIUM) @map("default_urgency")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  isPublished     Boolean   @default(true) @map("is_published")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  defaultTeam  Team?        @relation(fields: [defaultTeamId], references: [id], onDelete: SetNull)
  form         ServiceForm?
  tickets      Ticket[]
  slaPolicies  SlaPolicy[]

  @@unique([tenantId, slug])
  @@index([tenantId, isPublished])
  @@map("services")
}

model ServiceForm {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  serviceId String   @unique @map("service_id") @db.Uuid
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  service Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fields  ServiceFormField[]

  @@index([tenantId])
  @@map("service_forms")
}

model ServiceFormField {
  id          String  @id @default(uuid()) @db.Uuid
  formId      String  @map("form_id") @db.Uuid
  key         String  @db.VarChar(64)
  label       String  @db.VarChar(140)
  fieldType   String  @map("field_type") @db.VarChar(32) // text | textarea | select | number | date | boolean
  required    Boolean @default(false)
  placeholder String? @db.VarChar(200)
  optionsJson Json?   @map("options_json")
  sortOrder   Int     @default(0) @map("sort_order")

  form ServiceForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, key])
  @@map("service_form_fields")
}

// ---------------------------------------------------------------------------
// Tickets & Lifecycle
// ---------------------------------------------------------------------------

model TicketSequence {
  tenantId   String @map("tenant_id") @db.Uuid
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, year])
  @@map("ticket_sequences")
}

model Ticket {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  publicNumber           String        @map("public_number") @db.VarChar(32)
  title                  String        @db.VarChar(240)
  descriptionHtml        String        @map("description_html") @db.Text
  descriptionText        String        @map("description_text") @db.Text
  type                   TicketType    @default(INCIDENT)
  channel                TicketChannel @default(PORTAL)
  status                 TicketStatus  @default(NEW)
  impact                 ImpactUrgency @default(MEDIUM)
  urgency                ImpactUrgency @default(MEDIUM)
  priority               PriorityLevel @default(MEDIUM)
  priorityOverridden     Boolean       @default(false) @map("priority_overridden")
  priorityOverrideReason String?       @map("priority_override_reason") @db.VarChar(500)
  subcategory            String?       @db.VarChar(120)
  tags                   String[]      @default([])
  customFields           Json          @default("{}") @map("custom_fields")
  resolutionSummary      String?       @map("resolution_summary") @db.Text
  cancellationReason     String?       @map("cancellation_reason") @db.VarChar(500)
  csatScore              Int?          @map("csat_score")
  csatComment            String?       @map("csat_comment") @db.VarChar(1000)

  requesterId    String  @map("requester_id") @db.Uuid
  unitId         String? @map("unit_id") @db.Uuid
  departmentId   String? @map("department_id") @db.Uuid
  assignedTeamId String? @map("assigned_team_id") @db.Uuid
  assigneeId     String? @map("assignee_id") @db.Uuid
  categoryId     String? @map("category_id") @db.Uuid
  serviceId      String? @map("service_id") @db.Uuid

  firstResponseAt DateTime? @map("first_response_at")
  resolvedAt      DateTime? @map("resolved_at")
  closedAt        DateTime? @map("closed_at")
  canceledAt      DateTime? @map("canceled_at")
  dueAt           DateTime? @map("due_at")

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester    User         @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedTeam Team?        @relation("TicketAssignedTeam", fields: [assignedTeamId], references: [id], onDelete: SetNull)
  category     Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  participants  TicketParticipant[]
  comments      TicketComment[]
  attachments   TicketAttachment[]
  events        TicketEvent[]
  statusHistory TicketStatusHistory[]
  assignments   TicketAssignment[]
  slaInstances  SlaInstance[]
  approvals     Approval[]
  incident      Incident?
  problemLinks  ProblemTicket[]
  changeLinks   ChangeTicket[]
  assetLinks    TicketAsset[]
  aiSuggestions AiSuggestion[]

  @@unique([tenantId, publicNumber])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, priority, status])
  @@index([tenantId, assignedTeamId, status])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, unitId, status])
  @@index([tenantId, requesterId, createdAt(sort: Desc)])
  @@index([tenantId, dueAt])
  @@map("tickets")
}

model TicketParticipant {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @map("tenant_id") @db.Uuid
  ticketId  String          @map("ticket_id") @db.Uuid
  userId    String          @map("user_id") @db.Uuid
  kind      ParticipantKind @default(WATCHER)
  createdAt DateTime        @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([tenantId, ticketId])
  @@map("ticket_participants")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  bodyHtml   String   @map("body_html") @db.Text
  bodyText   String   @map("body_text") @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([tenantId, ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketAttachment {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  ticketId     String    @map("ticket_id") @db.Uuid
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  fileName     String    @map("file_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(120)
  sizeBytes    Int       @map("size_bytes")
  storageKey   String    @unique @map("storage_key") @db.VarChar(512)
  sha256       String    @db.VarChar(64)
  scanStatus   String    @default("CLEAN") @map("scan_status") @db.VarChar(32)
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id])

  @@index([tenantId, ticketId])
  @@map("ticket_attachments")
}

model TicketEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  ticketId      String   @map("ticket_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  eventType     String   @map("event_type") @db.VarChar(80)
  eventVersion  Int      @default(1) @map("event_version")
  payload       Json
  correlationId String?  @map("correlation_id") @db.VarChar(64)
  causationId   String?  @map("causation_id") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, createdAt])
  @@map("ticket_events")
}

model TicketStatusHistory {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @map("tenant_id") @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  actorId    String?       @map("actor_id") @db.Uuid
  fromStatus TicketStatus? @map("from_status")
  toStatus   TicketStatus  @map("to_status")
  reason     String?       @db.VarChar(500)
  changedAt  DateTime      @default(now()) @map("changed_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, ticketId, changedAt])
  @@map("ticket_status_history")
}

model TicketAssignment {
