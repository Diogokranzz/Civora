{
  "name": "@civora/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"test/integration/**\"",
    "test:integration": "vitest run test/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@civora/config": "workspace:*",
    "@civora/types": "workspace:*",
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.0.12",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.0.12",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.57.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@prisma/client": "^6.6.0",
    "@prisma/instrumentation": "^6.19.3",
    "bullmq": "^5.49.1",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jose": "^6.0.10",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^6.10.1",
    "opossum": "^10.0.0",
    "otpauth": "^9.4.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.15.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@civora/eslint-config": "workspace:*",
    "@civora/testing": "workspace:*",
    "@civora/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/testing": "^11.0.12",
    "@testcontainers/postgresql": "^10.22.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/nodemailer": "^6.4.17",
    "@types/opossum": "^8.1.9",
    "@types/sanitize-html": "^2.14.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.24.0",
    "prisma": "^6.6.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
